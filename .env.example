# Token privado del mock de BUK. Nunca se expone al navegador.
# En Vercel debe tener un valor largo y aleatorio.
BUK_API_TOKEN=tu_token_de_buk_aqui

# Endpoint POST de BUK. Déjalo vacío para usar el mock interno
# (/api/mock-buk/applicants) en Vercel o en local.
# Para BUK real: https://tu-instancia.buk.co/api/v1/applicants
BUK_API_URL=

# mock | buk
# "mock" etiqueta la demo como Mock BUK. "buk" la etiqueta como BUK real.
BUK_MODE=mock

# URL pública del sitio (se usa para metadataBase y Open Graph).
# En Vercel puedes dejarla vacía: se detecta automáticamente.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: puerto del mock local en scripts/mock-buk.mjs (por defecto 4000).
# Next.js no carga esta variable automáticamente.
MOCK_BUK_PORT=4000
